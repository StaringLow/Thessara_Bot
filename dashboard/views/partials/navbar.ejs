<nav class="navbar">
  <div class="navbar-brand">
    <span class="navbar-logo">🔮</span>
    <span class="navbar-name"><%= botName %></span>
  </div>
  <div class="navbar-user">
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (user.avatar) { %>
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" class="navbar-avatar" alt="<%= user.username %>">
      <% } else { %>
        <div class="navbar-avatar-placeholder"><%= user.username.charAt(0).toUpperCase() %></div>
      <% } %>
      <span class="navbar-username"><%= user.username %></span>
      <a href="/logout" class="btn-logout">Déconnexion</a>
    <% } %>
  </div>
</nav>
